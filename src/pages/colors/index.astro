---
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import { COLOR_GROUPS } from '@/lib/colors';
import { SITE_NAME } from '@/lib/site';
import { getLocale, getMessages } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const message = getMessages(locale);
const description =
  locale === 'es'
    ? 'La paleta de colores de este sitio, en modo claro y oscuro.'
    : 'The color palette behind this site, in light and dark.';
---

<Layout title=`Colors — ${SITE_NAME}` description={description} canonicalPath="/colors/">
  <main class="content-shell">
    <PageHero title={locale === 'es' ? 'Colores' : 'Colors'} hideTitle>
      <Lede>
        {message.colorsDescription} <span class="palette-mode-dark">{message.dark}</span>
        <span class="palette-mode-light">{message.light}</span>.
      </Lede>
    </PageHero>

    <section class="section grid gap-10" aria-label="Color palette">
      {COLOR_GROUPS.map((group) => (
        <div>
          <h2 class="m-0 mb-4 font-heading text-[1.3rem] font-bold text-ink">
            {locale === 'es'
              ? ({
                  Surfaces: 'Superficies',
                  Text: 'Texto',
                  Lines: 'Líneas',
                  Accents: 'Acentos',
                  Status: 'Estado',
                  Terminal: 'Terminal',
                }[group.title] ?? group.title)
              : group.title}
          </h2>
          <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
            {group.tokens.map((token) => (
              <div class="border-2 border-ink bg-bg-elevated shadow-[4px_4px_0_0_var(--ink)]">
                <div class="h-20 border-b-2 border-ink" style={`background-color: var(--${token})`} />
                <div class="p-3">
                  <p class="m-0 font-mono text-[0.8rem] font-bold text-ink">--{token}</p>
                  <p class="m-0 mt-1 font-mono text-[0.75rem] text-muted" data-color-value={token}>
                    &nbsp;
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="section" aria-label={message.acknowledgements}>
      <p class="m-0 text-muted">
        {message.colorStyle}
        <a class="font-semibold text-accent" href="https://neubrutalism.com/" target="_blank" rel="noopener">
          neubrutalism.com
        </a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .palette-mode-light {
    display: none;
  }

  :global([data-palette$='-light']) .palette-mode-light {
    display: inline;
  }

  :global([data-palette$='-light']) .palette-mode-dark {
    display: none;
  }
</style>

<script>
  function updateColorValues(): void {
    const rootStyles: CSSStyleDeclaration = getComputedStyle(document.documentElement);
    const valueElements: NodeListOf<HTMLElement> = document.querySelectorAll('[data-color-value]');

    valueElements.forEach((valueElement: HTMLElement): void => {
      const tokenName: string = `--${valueElement.dataset.colorValue}`;
      valueElement.textContent = rootStyles.getPropertyValue(tokenName).trim();
    });
  }

  new MutationObserver(updateColorValues).observe(document.documentElement, {
    attributeFilter: ['data-palette'],
  });

  document.addEventListener('astro:page-load', updateColorValues);
</script>
