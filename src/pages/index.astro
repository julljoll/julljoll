---
import FallingLeaves from '@/components/effects/FallingLeaves.astro';
import FallingPetals from '@/components/effects/FallingPetals.astro';
import FallingSnow from '@/components/effects/FallingSnow.astro';
import HeatShimmer from '@/components/effects/HeatShimmer.astro';
import Layout from '@/components/Layout.astro';
import Highlight from '@/components/Highlight.astro';
import PageHero from '@/components/PageHero.astro';
import Sunlight from '@/components/effects/Sunlight.astro';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, GITHUB_URL, LINKEDIN_URL, SITE_NAME } from '@/lib/site';

const description =
  'Perfil de julljoll: formación universitaria en Derecho y proyectos de informática forense, evidencia digital y documentación técnica para procesos judiciales.';
const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_NAME,
  description,
  url: new URL(withBase('/'), Astro.site).toString(),
  sameAs: [GITHUB_URL, LINKEDIN_URL].filter(Boolean),
}).replace(/</g, '\\u003c');
---

<Layout title={`${SITE_NAME} — Perfil profesional`} description={description} canonicalPath="/">
  <script type="application/ld+json" is:inline set:html={personSchema}></script>
  <FallingLeaves />
  <FallingSnow />
  <FallingPetals />
  <Sunlight />
  <HeatShimmer>
    <main class="content-shell">
      <PageHero title="Perfil de julljoll" hideTitle eyebrow="Perfil · Emprendimiento">
        <h2 class="max-w-[19ch] text-[clamp(2.7rem,6vw,5rem)] leading-[1.03] tracking-[-0.045em]">
          Informática forense y dictámenes periciales para <Highlight>procesos judiciales</Highlight>.
        </h2>
        <p class="mt-6 max-w-[42rem] text-[clamp(1.1rem,2vw,1.35rem)] leading-[1.6] text-ink-soft">
          Soy {AUTHOR_NAME}. Mi formación universitaria en Derecho se une a proyectos de informática forense y al
          trabajo de SHA256.US en reparación, extracción y análisis de información de dispositivos móviles. El enfoque:
          examinar evidencia digital y documentar hallazgos técnicos para su valoración en contextos judiciales.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="profile-link" href="https://sha256.us/es/" target="_blank" rel="noopener noreferrer">
            Conoce SHA256.US
          </a>
          <a
            class="profile-link profile-link-secondary"
            href="https://blog-astro-fawn.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Explora el blog forense
          </a>
        </div>
      </PageHero>

      <section class="section" aria-labelledby="areas-title">
        <div class="mb-6 max-w-[44rem]">
          <p class="font-mono text-sm font-bold tracking-[0.12em] text-accent uppercase">SHA256.US</p>
          <h2 id="areas-title" class="mt-2 text-[clamp(1.8rem,4vw,2.7rem)] leading-tight tracking-[-0.03em]">
            Áreas del proyecto
          </h2>
          <p class="mt-3 max-w-[40rem] leading-[1.6] text-ink-soft">
            El proyecto reúne servicios de recuperación y análisis técnico de dispositivos, documentos y evidencia
            digital.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          <article class="profile-card">
            <h3>Dispositivos móviles</h3>
            <p>
              Reparación, extracción de información y validación de audios, imágenes, mensajes y contenido de
              aplicaciones de mensajería.
            </p>
          </article>
          <article class="profile-card">
            <h3>Evidencia y documentos digitales</h3>
            <p>
              Informática forense, análisis de contratos y documentos electrónicos, y revisión de firmas, metadatos y
              posibles alteraciones.
            </p>
          </article>
          <article class="profile-card">
            <h3>Análisis técnico-jurídico</h3>
            <p>
              Análisis de datos e información legal y soporte técnico para procesos de cumplimiento normativo, según lo
              descrito en los sitios del proyecto.
            </p>
          </article>
        </div>
        <p class="mt-5 max-w-[54rem] text-sm leading-[1.6] text-ink-soft">
          El blog del proyecto cita referencias como ISO/IEC 27037, ISO/IEC 27042, NIST SP 800 y MUCC-2017.
        </p>
      </section>

      <section class="section" aria-labelledby="judicial-title">
        <div class="grid gap-6 md:grid-cols-[minmax(0,1.3fr)_minmax(16rem,0.7fr)]">
          <article class="profile-card">
            <p class="mb-2 font-mono text-sm font-bold tracking-[0.12em] text-accent uppercase">Formación aplicable</p>
            <h2 id="judicial-title">Perspectiva jurídica para la evidencia digital</h2>
            <p>
              Cursé la Licenciatura en Derecho en la Universidad Nacional Experimental de los Llanos Occidentales
              “Ezequiel Zamora”, Barinas (2005–2010). Esta formación aporta contexto jurídico a mi interés en la
              documentación, trazabilidad y comunicación clara de hallazgos técnicos en asuntos judiciales.
            </p>
            <p class="mt-3">
              Mi experiencia en diseño gráfico, retoque de imágenes y edición de vídeo complementa la presentación
              visual de los hallazgos; no sustituye los métodos forenses necesarios para verificar una evidencia.
            </p>
          </article>
          <aside class="profile-card profile-note">
            <h3>Alcance pericial</h3>
            <p>
              La actuación como perito, la elaboración o ratificación de un dictamen y su admisibilidad dependen de los
              requisitos legales y procesales aplicables en cada jurisdicción.
            </p>
          </aside>
        </div>
      </section>
    </main>
  </HeatShimmer>
</Layout>

<style>
  @reference "@/styles/global.css";

  .profile-link {
    @apply inline-flex min-h-12 items-center justify-center border-2 border-ink bg-accent px-5 py-3 font-heading font-bold text-bg shadow-[4px_4px_0_0_var(--ink)] transition-[translate,box-shadow] duration-120 ease-[ease] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_var(--ink)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink;
  }

  .profile-link-secondary {
    @apply bg-bg text-ink;
  }

  .profile-card {
    @apply border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)];
  }

  .profile-card h3 {
    @apply m-0 text-[1.4rem] leading-[1.2] font-bold tracking-[-0.02em] text-ink;
  }

  .profile-card h2 {
    @apply m-0 text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.1] font-bold tracking-[-0.03em] text-ink;
  }

  .profile-card p {
    @apply mb-0 leading-[1.6] text-ink-soft;
  }

  .profile-card > p:first-child {
    @apply mb-2;
  }

  .profile-note {
    @apply flex flex-col justify-center border-dashed;
  }
</style>
