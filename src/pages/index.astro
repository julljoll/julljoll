---
import FallingLeaves from '@/components/effects/FallingLeaves.astro';
import FallingPetals from '@/components/effects/FallingPetals.astro';
import FallingSnow from '@/components/effects/FallingSnow.astro';
import HeatShimmer from '@/components/effects/HeatShimmer.astro';
import Layout from '@/components/Layout.astro';
import Highlight from '@/components/Highlight.astro';
import PageHero from '@/components/PageHero.astro';
import Sunlight from '@/components/effects/Sunlight.astro';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, GITHUB_URL, JOB_TITLE, LINKEDIN_URL, SITE_NAME } from '@/lib/site';

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_NAME,
  jobTitle: JOB_TITLE || undefined,
  url: new URL(withBase('/'), Astro.site).toString(),
  sameAs: [GITHUB_URL, LINKEDIN_URL].filter(Boolean),
}).replace(/</g, '\\u003c');
---

<Layout
  title={SITE_NAME}
  description="Un sitio personal para compartir notas, proyectos y experimentos."
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={personSchema}></script>
  <FallingLeaves />
  <FallingSnow />
  <FallingPetals />
  <Sunlight />
  <HeatShimmer>
    <main class="content-shell">
      <PageHero title="Inicio" hideTitle>
        <h2 class:list={['text-[clamp(3rem,4.5vw,4.25rem)]', 'leading-[1.1]', 'tracking-[-0.03em]']}>
          Un rincón de internet <Highlight>neobrutalista</Highlight> que cambia con las{' '}
          <Highlight>estaciones</Highlight>.
        </h2>
      </PageHero>

      <section class="section" aria-label="Acerca de">
        <div class="flex justify-center w-full mt-10">
          <div class="card">
            <div class="about-prose">
              <p>
                Este es un <Highlight bold>sitio personal</Highlight> creado con un tema de Astro{' '}
                <Highlight bold>neobrutalista</Highlight>. Sus colores siguen el calendario y cambian entre{' '}
                <Highlight bold>otoño</Highlight>, <Highlight bold>invierno</Highlight>,{' '}
                <Highlight bold>primavera</Highlight> y <Highlight bold>verano</Highlight>, cada uno con modo claro y
                oscuro.
              </p>

              <p>Un espacio para notas, proyectos y experimentos, con una paleta distinta en cada estación.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </HeatShimmer>
</Layout>

<style>
  @reference "@/styles/global.css";

  .card {
    @apply rounded-none border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)];
  }

  .about-prose p {
    @apply mb-[1.2rem] font-heading text-[1.3rem] leading-[1.75] last:mb-0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
