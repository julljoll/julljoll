---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import TagCloudSection from '@/components/tags/TagCloudSection.astro';
import { getAllTags } from '@/lib/tags';
import { SITE_NAME } from '@/lib/site';
import { getLocale, getMessages } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const message = getMessages(locale);
const title = locale === 'es' ? 'Etiquetas' : 'Tags';
const tags = getAllTags((await getCollection('blog')).filter((post) => post.data.locale === locale));
---

<Layout title={`${title} — ${SITE_NAME}`} description={message.tagsDescription} canonicalPath="/tags/">
  <main class="content-shell">
    <PageHero title={title} hideTitle>
      <Lede>{message.tagsDescription}</Lede>
    </PageHero>
    <TagCloudSection locale={locale} tags={tags} />
  </main>
</Layout>
