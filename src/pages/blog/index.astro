---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/posts/PostCard.astro';
import { withBase } from '@/lib/paths';
import { SITE_NAME } from '@/lib/site';
import { localizedPath, getLocale, getMessages } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const message = getMessages(locale);
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.locale === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`Blog — ${SITE_NAME}`} description={message.blogDescription} canonicalPath="/blog/">
  <main class="content-shell">
    <PageHero title="Blog" hideTitle>
      <Lede>{message.blogDescription}</Lede>
      <a class="tags-link" href={withBase(localizedPath('/tags/', locale))}>
        {message.browseTags} <span aria-hidden="true">→</span>
      </a>
    </PageHero>

    <section class="section" aria-label={locale === 'es' ? 'Publicaciones del blog' : 'Blog posts'}>
      {posts.length === 0 ? (
        <p class="text-muted">{message.noPosts}</p>
      ) : (
        <div class="grid gap-8">
          {posts.map((post, index) => (
            <PostCard post={post} latest={index === 0} />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  @reference "@/styles/global.css";

  .tags-link {
    @apply inline-flex min-h-[2.6rem] items-center gap-2 border-2 border-ink bg-bg-elevated px-[1.1rem] py-[0.6rem];
    @apply font-heading text-[0.9rem] font-semibold text-ink shadow-[3px_3px_0_0_var(--ink)];
    @apply transition-[translate,box-shadow,background-color,color] duration-120 ease-[ease];
  }

  .tags-link:hover {
    @apply translate-x-[1px] translate-y-[1px] bg-accent text-bg shadow-[2px_2px_0_0_var(--ink)];
  }
</style>
