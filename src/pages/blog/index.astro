---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import BlogListingHeader from '@/components/blog/BlogListingHeader.astro';
import BlogPostList from '@/components/blog/BlogPostList.astro';
import { SITE_NAME } from '@/lib/site';
import { getLocale, getMessages } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const message = getMessages(locale);
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.locale === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`Blog — ${SITE_NAME}`} description={message.blogDescription} canonicalPath="/blog/">
  <main class="content-shell">
    <BlogListingHeader locale={locale} description={message.blogDescription} />
    <BlogPostList locale={locale} posts={posts} />
  </main>
</Layout>
