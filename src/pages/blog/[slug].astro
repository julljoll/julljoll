---
import { getCollection, render } from 'astro:content';
import Layout from '@/components/Layout.astro';
import BlogPostContent from '@/components/blog/BlogPostContent.astro';
import { postImage, postSlug } from '@/lib/posts';
import { getLocale } from '@/lib/i18n';
import { SITE_NAME } from '@/lib/site';

const locale = getLocale(Astro.url.pathname);

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft && post.data.locale === 'es')
    .map((post) => ({
      params: { slug: postSlug(post) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
  title={`${post.data.title} — ${SITE_NAME}`}
  description={post.data.description}
  canonicalPath={`/blog/${postSlug(post)}/`}
  ogType="article"
  ogImage={postImage(post)}
>
  <main class="content-shell">
    <BlogPostContent post={post} headings={headings} locale={locale}>
      <Content />
    </BlogPostContent>
  </main>
</Layout>
