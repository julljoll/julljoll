---
import { getCollection, render } from 'astro:content';
import Layout from '@/components/Layout.astro';
import BlogPostContent from '@/components/blog/BlogPostContent.astro';
import { postImage, postSlug } from '@/lib/posts';
import { localizedPath } from '@/lib/i18n';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, GOOGLE_MAPS_URL, SITE_NAME, WEBSITE_URL } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft && post.data.locale === 'en')
    .map((post) => ({
      params: { slug: postSlug(post) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const postCanonicalPath = `/blog/${postSlug(post)}/`;
const postUrl = new URL(withBase(localizedPath(postCanonicalPath, 'en')), Astro.site).toString();
const postImageUrl = new URL(withBase(postImage(post) ?? '/assets/og.png'), Astro.site).toString();

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: postImageUrl,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: new URL(withBase('/en/'), Astro.site).toString(),
  },
  publisher: {
    '@type': ['LegalService', 'ProfessionalService'],
    name: 'SHA256.US',
    url: WEBSITE_URL,
    hasMap: GOOGLE_MAPS_URL,
  },
  keywords: post.data.tags.join(', '),
  inLanguage: 'en',
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${post.data.title} — ${SITE_NAME}`}
  description={post.data.description}
  canonicalPath={postCanonicalPath}
  ogType="article"
  ogImage={postImage(post)}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.date.toISOString()}
  tags={post.data.tags}
  section="Digital Forensics"
>
  <script type="application/ld+json" is:inline set:html={articleSchema}></script>
  <main class="content-shell">
    <BlogPostContent post={post} headings={headings} locale="en">
      <Content />
    </BlogPostContent>
  </main>
</Layout>
