---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import BlogListingHeader from '@/components/blog/BlogListingHeader.astro';
import BlogPostList from '@/components/blog/BlogPostList.astro';
import { BLOG_DESCRIPTION, SITE_DESCRIPTION, SITE_NAME } from '@/lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.locale === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`Blog — ${SITE_NAME}`} description={SITE_DESCRIPTION} canonicalPath="/blog/">
  <main class="content-shell">
    <BlogListingHeader locale="en" description={BLOG_DESCRIPTION} />
    <BlogPostList locale="en" posts={posts} />
  </main>
</Layout>
