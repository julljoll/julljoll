---
import { SITE_NAME } from '@/lib/site';
import Layout from '@/components/Layout.astro';
import AboutHero from '@/components/about/AboutHero.astro';
import AboutEducation from '@/components/about/AboutEducation.astro';
import AboutCertifications from '@/components/about/AboutCertifications.astro';
import AboutExperience from '@/components/about/AboutExperience.astro';
import AboutApproach from '@/components/about/AboutApproach.astro';
import AboutForensicScope from '@/components/about/AboutForensicScope.astro';
import { getMessages } from '@/lib/i18n';

const message = getMessages('en');
---

<Layout title={`About me — ${SITE_NAME}`} description={message.aboutDescription} canonicalPath="/experience/">
  <main class="content-shell">
    <AboutHero locale="en" />
    <AboutEducation locale="en" />
    <AboutCertifications locale="en" />
    <AboutExperience locale="en" />
    <AboutApproach locale="en" />
    <AboutForensicScope locale="en" />
  </main>
</Layout>
