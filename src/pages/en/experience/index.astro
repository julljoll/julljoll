---
import { AUTHOR_NAME, GITHUB_URL, INSTAGRAM_URL, JOB_TITLE, LINKEDIN_URL, SITE_NAME, WEBSITE_URL, X_URL } from '@/lib/site';
import { withBase } from '@/lib/paths';
import Layout from '@/components/Layout.astro';
import AboutHero from '@/components/about/AboutHero.astro';
import AboutEducation from '@/components/about/AboutEducation.astro';
import AboutCertifications from '@/components/about/AboutCertifications.astro';
import AboutExperience from '@/components/about/AboutExperience.astro';
import AboutApproach from '@/components/about/AboutApproach.astro';
import AboutForensicScope from '@/components/about/AboutForensicScope.astro';
import { getMessages } from '@/lib/i18n';

const message = getMessages('en');
const profilePageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(withBase('/en/experience/'), Astro.site).toString(),
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    jobTitle: JOB_TITLE,
    description: message.aboutDescription,
    url: new URL(withBase('/en/'), Astro.site).toString(),
    sameAs: [GITHUB_URL, LINKEDIN_URL, WEBSITE_URL, INSTAGRAM_URL, X_URL].filter(Boolean),
  },
}).replace(/</g, '\\u003c');
---

<Layout title={`About me — ${SITE_NAME}`} description={message.aboutDescription} canonicalPath="/experience/" ogType="profile">
  <script type="application/ld+json" is:inline set:html={profilePageSchema}></script>
  <main class="content-shell">
    <AboutHero locale="en" />
    <AboutEducation locale="en" />
    <AboutCertifications locale="en" />
    <AboutExperience locale="en" />
    <AboutApproach locale="en" />
    <AboutForensicScope locale="en" />
  </main>
</Layout>
