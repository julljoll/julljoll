---
import { SITE_NAME } from '@/lib/site';
import { FEATURED_PROJECTS } from '@/lib/projects';
import { withBase } from '@/lib/paths';
import Layout from '@/components/Layout.astro';
import ProjectsGrid from '@/components/ProjectsGrid.astro';
import ProjectPageHeader from '@/components/projects/ProjectPageHeader.astro';
import { getMessages } from '@/lib/i18n';

const message = getMessages('en');
const projectsSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Projects — ${SITE_NAME}`,
  description: message.projectsDescription,
  url: new URL(withBase('/en/projects/'), Astro.site).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: FEATURED_PROJECTS.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.name,
      description: project.description.en,
      url: project.url,
    })),
  },
}).replace(/</g, '\\u003c');
---

<Layout title={`Projects — ${SITE_NAME}`} description={message.projectsDescription} canonicalPath="/projects/">
  <script type="application/ld+json" is:inline set:html={projectsSchema}></script>
  <main class="content-shell">
    <ProjectPageHeader locale="en" description={message.projectsDescription} />
    <ProjectsGrid locale="en" />
  </main>
</Layout>
