---
import { SITE_NAME } from '@/lib/site';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectsGrid from '@/components/ProjectsGrid.astro';
import { getMessages } from '@/lib/i18n';
---

<Layout
  title={`Projects — ${SITE_NAME}`}
  description={getMessages('en').projectsDescription}
  canonicalPath="/projects/"
>
  <main class="content-shell">
    <PageHero title="Projects" hideTitle>
      <Lede>{getMessages('en').projectsDescription}</Lede>
    </PageHero>

    <ProjectsGrid locale="en" />
  </main>
</Layout>
