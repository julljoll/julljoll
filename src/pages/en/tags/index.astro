---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import TagCloudSection from '@/components/tags/TagCloudSection.astro';
import { getAllTags } from '@/lib/tags';
import { SITE_NAME, TAGS_DESCRIPTION } from '@/lib/site';

const tags = getAllTags((await getCollection('blog')).filter((post) => post.data.locale === 'en'));
---

<Layout title={`Tags — ${SITE_NAME}`} description={TAGS_DESCRIPTION} canonicalPath="/tags/">
  <main class="content-shell">
    <PageHero title="Tags" hideTitle>
      <Lede>{TAGS_DESCRIPTION}</Lede>
    </PageHero>
    <TagCloudSection locale="en" tags={tags} />
  </main>
</Layout>
