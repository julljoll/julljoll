---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '@/components/Layout.astro';
import TagArchiveContent from '@/components/tags/TagArchiveContent.astro';
import { getAllTags, slugifyTag } from '@/lib/tags';
import { SITE_NAME } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const published = posts
    .filter((post) => !post.data.draft && post.data.locale === 'en')
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return getAllTags(published).map(({ slug, name }) => ({
    params: { tag: slug },
    props: {
      name,
      posts: published.filter((post) => post.data.tags.some((tag) => slugifyTag(tag) === slug)),
    },
  }));
}

interface Props {
  name: string;
  posts: CollectionEntry<'blog'>[];
}

const { name, posts } = Astro.props;
const slug = Astro.params.tag!;
---

<Layout title={`#${name} — ${SITE_NAME}`} description={`Posts tagged "${name}".`} canonicalPath={`/tags/${slug}/`}>
  <main class="content-shell">
    <TagArchiveContent locale="en" name={name} posts={posts} />
  </main>
</Layout>
