---
import { PROJECTS_DESCRIPTION, SITE_NAME } from '@/lib/site';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
---

<Layout title=`Projects — ${SITE_NAME}` description={PROJECTS_DESCRIPTION} canonicalPath="/projects/">
  <main class="content-shell">
    <PageHero title="Projects" hideTitle>
      <Lede>{PROJECTS_DESCRIPTION}</Lede>
    </PageHero>

    <section class="section grid gap-8 md:grid-cols-2" aria-label="Projects">
      <p class="text-muted">Projects will be added here.</p>
    </section>
  </main>
</Layout>
