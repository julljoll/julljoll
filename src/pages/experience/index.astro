---
import {
  AUTHOR_NAME,
  GITHUB_URL,
  GOOGLE_MAPS_URL,
  INSTAGRAM_URL,
  JOB_TITLE,
  LINKEDIN_URL,
  SITE_NAME,
  WEBSITE_URL,
  X_URL,
} from '@/lib/site';
import { withBase } from '@/lib/paths';
import Layout from '@/components/Layout.astro';
import AboutHero from '@/components/about/AboutHero.astro';
import AboutEducation from '@/components/about/AboutEducation.astro';
import AboutCertifications from '@/components/about/AboutCertifications.astro';
import AboutExperience from '@/components/about/AboutExperience.astro';
import AboutApproach from '@/components/about/AboutApproach.astro';
import AboutForensicScope from '@/components/about/AboutForensicScope.astro';
import { getLocale, getMessages } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const message = getMessages(locale);
const profilePageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(withBase('/experience/'), Astro.site).toString(),
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    jobTitle: JOB_TITLE,
    description: message.aboutDescription,
    url: new URL(withBase('/'), Astro.site).toString(),
    worksFor: {
      '@type': ['LegalService', 'ProfessionalService'],
      name: 'SHA256.US',
      url: WEBSITE_URL,
      hasMap: GOOGLE_MAPS_URL,
    },
    sameAs: [GITHUB_URL, LINKEDIN_URL, WEBSITE_URL, GOOGLE_MAPS_URL, INSTAGRAM_URL, X_URL].filter(Boolean),
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${locale === 'es' ? 'Sobre mí' : 'About me'} — ${SITE_NAME}`}
  description={message.aboutDescription}
  canonicalPath="/experience/"
  ogType="profile"
>
  <script type="application/ld+json" is:inline set:html={profilePageSchema}></script>
  <main class="content-shell">
    <AboutHero locale={locale} />
    <AboutEducation locale={locale} />
    <AboutCertifications locale={locale} />
    <AboutExperience locale={locale} />
    <AboutApproach locale={locale} />
    <AboutForensicScope locale={locale} />
  </main>
</Layout>
