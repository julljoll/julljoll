---
import { SITE_NAME } from '@/lib/site';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import { getLocale, getMessages } from '@/lib/i18n';
---

<Layout
  title={`${Astro.currentLocale === 'en' ? 'Experience' : 'Experiencia'} — ${SITE_NAME}`}
  description={getMessages(getLocale(Astro.url.pathname)).experienceDescription}
  canonicalPath="/experience/"
>
  <main class="content-shell">
    <PageHero title={Astro.currentLocale === 'en' ? 'Experience' : 'Experiencia'} hideTitle>
      <Lede>{getMessages(getLocale(Astro.url.pathname)).experienceDescription}</Lede>
    </PageHero>

    <section
      class="section grid gap-8"
      aria-label={Astro.currentLocale === 'en' ? 'Work experience' : 'Experiencia laboral'}
    >
      <p class="text-muted">{getMessages(getLocale(Astro.url.pathname)).experienceEmpty}</p>
    </section>
  </main>
</Layout>
