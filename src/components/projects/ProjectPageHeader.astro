---
import type { Locale } from '@/lib/i18n';
import PageHero from '@/components/PageHero.astro';
import Lede from '@/components/Lede.astro';

interface Props {
  locale: Locale;
  description: string;
}

const { locale, description } = Astro.props;
const eyebrow =
  locale === 'es'
    ? 'SHA256.US · Informática Forense y Repositorios Oficiales'
    : 'SHA256.US · Digital Forensics & Official Repositories';
---

<PageHero title={locale === 'es' ? 'Proyectos' : 'Projects'} eyebrow={eyebrow} hideTitle>
  <Lede>{description}</Lede>
</PageHero>
