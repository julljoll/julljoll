---
import type { Locale } from '@/lib/i18n';
import { CERTIFICATIONS } from '@/lib/certifications';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Cursos y certificaciones',
    intro:
      'Formación complementaria en informática forense, ciberseguridad, diseño de experiencia, investigación jurídica, gestión de proyectos e inteligencia artificial.',
    verify: 'Verificar credencial',
    note: 'Los cursos y credenciales se presentan según el emisor y el alcance indicado en cada documento; no equivalen a títulos universitarios ni, por sí solos, a una habilitación como perito.',
  },
  en: {
    title: 'Courses and certifications',
    intro:
      'Additional learning in digital forensics, cybersecurity, user experience design, legal research, project management, and artificial intelligence.',
    verify: 'Verify credential',
    note: 'Courses and credentials are described according to each issuer and document; they are not university degrees or, by themselves, qualifications as an expert witness.',
  },
}[locale];
---

<section class="section" aria-labelledby="about-certifications-title">
  <div class="mb-6 max-w-[52rem]">
    <h2 id="about-certifications-title" class="text-[clamp(1.8rem,4vw,2.5rem)] leading-tight tracking-[-0.03em]">
      {text.title}
    </h2>
    <p class="mt-3 leading-[1.6] text-ink-soft">{text.intro}</p>
  </div>
  <ul class="grid list-none gap-4 p-0 md:grid-cols-2">
    {CERTIFICATIONS.map((certification) => (
      <li class="flex flex-col border-2 border-ink bg-bg-elevated p-5 shadow-[5px_5px_0_0_var(--ink)]">
        <p class="m-0 font-mono text-xs font-bold tracking-[0.08em] text-accent uppercase">
          {certification.category[locale]}
        </p>
        <h3 class="mt-2 mb-2 text-lg leading-[1.25] font-bold">{certification.title[locale]}</h3>
        <p class="m-0 text-sm leading-[1.5] text-ink-soft">
          {certification.issuer.includes('SUSCERTE') ? (
            <>
              <a
                href="https://www.suscerte.gob.ve/"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-1 underline-offset-2 hover:text-accent"
              >
                SUSCERTE
              </a>
              <span>{certification.issuer.replace('SUSCERTE', '')}</span>
            </>
          ) : (
            certification.issuer
          )}
        </p>
        <p class="mt-2 mb-0 font-mono text-xs text-ink-soft">{certification.date[locale]}</p>
        {certification.detail && (
          <p class="mt-3 mb-0 text-sm leading-[1.5] text-ink-soft">{certification.detail[locale]}</p>
        )}
        {certification.verificationUrl && (
          <a
            class="mt-4 w-fit font-heading text-sm font-bold text-accent underline decoration-2 underline-offset-4"
            href={certification.verificationUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {text.verify} <span aria-hidden="true">↗</span>
          </a>
        )}
      </li>
    ))}
  </ul>
  <p class="mt-6 max-w-[60rem] text-sm leading-[1.6] text-ink-soft">{text.note}</p>
</section>
