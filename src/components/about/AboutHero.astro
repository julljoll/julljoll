---
import type { Locale } from '@/lib/i18n';
import PageHero from '@/components/PageHero.astro';
import Lede from '@/components/Lede.astro';
import { AUTHOR_NAME } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Sobre mí',
    eyebrow:
      'Data & AI Analyst | Governed, On-Premise AI for Legal, Compliance & Digital Forensics | RAG · Explainable AI · Data Governance',
    headline: 'Transformo datos complejos y de alto riesgo en sistemas de IA que puedes auditar.',
    lede: `Soy ${AUTHOR_NAME}, licenciado en Derecho y formado en fundamentos básicos de informática forense (SUSCERTE). Preparo los datos (ingesta y estructuración documental con Docling), diseño la arquitectura (pipelines RAG sobre el stack open-source de IBM) y la implemento localmente bajo estrictos controles de seguridad, para que la información sensible nunca salga del entorno.`,
    paragraphs: [
      'Mi enfoque es la gobernanza por diseño (Governance by Design): salidas explicables (Explainable AI) que trazan cada afirmación hasta su fragmento exacto en la fuente, barreras de seguridad contra alucinaciones y sesgos (IBM Granite Guardian), y cumplimiento normativo y cadena de custodia integrados en el flujo de trabajo para que los resultados se sostengan ante una auditoría o un tribunal.',
      'Herramientas y marcos de referencia: Python · Docling · IBM Granite · RAG · Granite Guardian · Podman · OCI · NIST AI RMF · ISO/IEC 27001 · ISO/IEC 42001 · ISO/IEC 27037.',
      'Abierto a roles en gobernanza de IA (AI Governance), análisis de datos legal-tech y reportes forenses o de cumplimiento (disponibilidad como contratista remoto en zona horaria compatible con EE. UU.).',
    ],
  },
  en: {
    title: 'About me',
    eyebrow:
      'Data & AI Analyst | Governed, On-Premise AI for Legal, Compliance & Digital Forensics | RAG · Explainable AI · Data Governance',
    headline: 'I turn messy, high-stakes data into AI systems you can audit.',
    lede: `I'm ${AUTHOR_NAME}, a law graduate with foundational digital forensics training (SUSCERTE). I prepare the data (document ingestion and structuring with Docling), design the architecture (RAG pipelines on IBM open-source stack), and implement it locally under strict security controls, so sensitive information never leaves the environment.`,
    paragraphs: [
      'My focus is governance by design: explainable outputs that trace every claim to its exact source, guardrails against hallucination and bias (IBM Granite Guardian), and compliance and chain-of-custody built into the workflow, so results hold up in front of an auditor or a court.',
      'Tools & Frameworks: Python · Docling · IBM Granite · RAG · Granite Guardian · Podman · OCI · NIST AI RMF · ISO/IEC 27001 · ISO/IEC 42001 · ISO/IEC 27037.',
      'Open to roles in AI governance, legal-tech data analysis, and forensic/compliance reporting (available as a remote contractor in US-compatible time zones).',
    ],
  },
}[locale];
---

<PageHero title={text.title} eyebrow={text.eyebrow}>
  <h2 class="max-w-[24ch] text-[clamp(2.2rem,4.6vw,3.8rem)] leading-[1.05] tracking-[-0.045em]">
    {text.headline}
  </h2>
  <Lede>{text.lede}</Lede>
  <div class="mt-4 grid max-w-[54rem] gap-3 text-base leading-[1.65] text-ink-soft">
    {text.paragraphs.map((paragraph) => (
      <p class="m-0">{paragraph}</p>
    ))}
  </div>
</PageHero>
