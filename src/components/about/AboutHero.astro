---
import type { Locale } from '@/lib/i18n';
import PageHero from '@/components/PageHero.astro';
import Lede from '@/components/Lede.astro';
import { AUTHOR_NAME } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Sobre mí',
    eyebrow: 'Derecho · informática forense · diseño de experiencia',
    lede: `Soy ${AUTHOR_NAME}, licenciado en Derecho y formado en fundamentos básicos de informática forense (SUSCERTE, 16 horas). Complemento esa base con estudios de ciberseguridad, diseño UX, análisis de patentes y gestión de proyectos, además de experiencia profesional en diseño digital.`,
  },
  en: {
    title: 'About me',
    eyebrow: 'Law · digital forensics · user experience design',
    lede: `I'm ${AUTHOR_NAME}, a law graduate with foundational digital forensics training (SUSCERTE, 16 hours). My additional studies include cybersecurity, UX design, patent research, and project management, alongside professional experience in digital design.`,
  },
}[locale];
---

<PageHero title={text.title} eyebrow={text.eyebrow}>
  <h2 class="max-w-[20ch] text-[clamp(2.4rem,5vw,4.2rem)] leading-[1.03] tracking-[-0.045em]">
    {locale === 'es' ? 'Derecho, tecnología y análisis digital.' : 'Law, technology, and digital analysis.'}
  </h2>
  <Lede>{text.lede}</Lede>
</PageHero>
