---
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Trayectoria profesional',
    current: 'Data & AI Analyst (Governed AI · Legal & Digital Forensics) · Profesional independiente',
    currentDate: 'Enero de 2026–actualidad',
    currentDetail:
      'Diseño y desarrollo de arquitecturas de IA gobernada y ejecución local (On-Premise AI) para análisis jurídico, forense y de cumplimiento en SHA256.US. Implementación de pipelines de Document Intelligence con Docling, sistemas Legal-RAG sobre IBM Granite, filtros de Trust & Safety con Granite Guardian, trazabilidad Explainable AI (XAI) y flujos de cadena de custodia y preservación de evidencia digital alineados con NIST AI RMF, ISO/IEC 27001 e ISO/IEC 27037.',
    virtual: 'Diseñador gráfico y especialista UX/UI · Virtual Engine Marketing',
    virtualDate: 'Febrero de 2024–marzo de 2026',
    virtualDetail:
      'Diseño estratégico de interfaces y experiencias centradas en el usuario (UCD), prototipado en Figma, contenido para el sector inmobiliario, landing pages orientadas a conversión, más de 50 diseños estructurados en Figma e integrados en Klaviyo, y comunicación visual de información compleja.',
    sinner: 'Diseñador gráfico · SinnerArt',
    sinnerDate: 'Febrero de 2022–septiembre de 2023',
    sinnerDetail:
      'Creación de identidad visual y sistemas gráficos, retoque y análisis técnico de imagen, maquetación con plantillas responsivas en HTML/CSS y redacción de artículos estructurados para blogs.',
  },
  en: {
    title: 'Professional experience',
    current: 'Data & AI Analyst (Governed AI · Legal & Digital Forensics) · Independent professional',
    currentDate: 'January 2026–present',
    currentDetail:
      'Designing and building governed, on-premise AI architectures for legal, forensic, and compliance workflows at SHA256.US. Implementing Document Intelligence ingestion pipelines with Docling, Legal-RAG systems on IBM Granite, Trust & Safety guardrails with Granite Guardian, Explainable AI (XAI) source traceability, and digital evidence chain-of-custody workflows aligned with NIST AI RMF, ISO/IEC 27001, and ISO/IEC 27037.',
    virtual: 'Graphic & UX/UI Designer · Virtual Engine Marketing',
    virtualDate: 'February 2024–March 2026',
    virtualDetail:
      'User-Centered Design (UCD) interfaces and visual communication; Figma prototyping; strategic social content for the real estate sector; conversion-focused landing pages; and 50+ structured email systems created in Figma and integrated with Klaviyo.',
    sinner: 'Graphic designer · SinnerArt',
    sinnerDate: 'February 2022–September 2023',
    sinnerDetail:
      'Visual identities and graphic systems, professional image retouching and inspection, responsive HTML/CSS templates, and structured technical/editorial blog articles.',
  },
}[locale];
---

<section class="section" aria-labelledby="about-experience-title">
  <h2 id="about-experience-title" class="mb-6 text-[clamp(1.8rem,4vw,2.5rem)] leading-tight tracking-[-0.03em]">
    {text.title}
  </h2>
  <div class="grid gap-5">
    {[text.current, text.virtual, text.sinner].map((role, index) => {
      const date = [text.currentDate, text.virtualDate, text.sinnerDate][index];
      const detail = [text.currentDetail, text.virtualDetail, text.sinnerDetail][index];
      return (
        <article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
          <p class="m-0 font-mono text-sm font-bold tracking-[0.12em] text-accent uppercase">{date}</p>
          <h3 class="mt-2 mb-2 text-xl font-bold">{role}</h3>
          <p class="m-0 leading-[1.6] text-ink-soft">{detail}</p>
        </article>
      );
    })}
  </div>
</section>
