---
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Trayectoria profesional',
    current: 'Profesional independiente',
    currentDate: 'Enero de 2026–actualidad',
    currentDetail: 'Trabajo independiente en iniciativas de diseño y proyectos digitales.',
    virtual: 'Diseñador gráfico · Virtual Engine Marketing',
    virtualDate: 'Febrero de 2024–marzo de 2026',
    virtualDetail:
      'Diseño estratégico de contenido para redes sociales en el sector inmobiliario, landing pages orientadas a conversión, más de 50 correos electrónicos creados con Figma e integrados en Klaviyo, materiales promocionales, imágenes para blogs y vídeos para redes sociales.',
    sinner: 'Diseñador gráfico · SinnerArt',
    sinnerDate: 'Febrero de 2022–septiembre de 2023',
    sinnerDetail:
      'Creación de identidad visual y piezas gráficas, retoque profesional de imágenes, campañas de email marketing con plantillas responsivas en HTML/CSS y artículos para blogs.',
  },
  en: {
    title: 'Professional experience',
    current: 'Independent professional',
    currentDate: 'January 2026–present',
    currentDetail: 'Independent work across design initiatives and digital projects.',
    virtual: 'Graphic designer · Virtual Engine Marketing',
    virtualDate: 'February 2024–March 2026',
    virtualDetail:
      'Strategic social content for the real estate sector; conversion-focused landing pages; 50+ email designs created in Figma and integrated with Klaviyo; promotional materials, blog imagery, and social videos.',
    sinner: 'Graphic designer · SinnerArt',
    sinnerDate: 'February 2022–September 2023',
    sinnerDetail:
      'Visual identities and graphic materials, professional image retouching, email marketing with responsive HTML/CSS templates, and blog articles.',
  },
}[locale];
---

<section class="section" aria-labelledby="about-experience-title">
  <h2 id="about-experience-title" class="mb-6 text-[clamp(1.8rem,4vw,2.5rem)] leading-tight tracking-[-0.03em]">
    {text.title}
  </h2>
  <div class="grid gap-5">
    {[text.current, text.virtual, text.sinner].map((role, index) => {
      const date = [text.currentDate, text.virtualDate, text.sinnerDate][index];
      const detail = [text.currentDetail, text.virtualDetail, text.sinnerDetail][index];
      return (
        <article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
          <p class="m-0 font-mono text-sm font-bold tracking-[0.12em] text-accent uppercase">{date}</p>
          <h3 class="mt-2 mb-2 text-xl font-bold">{role}</h3>
          <p class="m-0 leading-[1.6] text-ink-soft">{detail}</p>
        </article>
      );
    })}
  </div>
</section>
