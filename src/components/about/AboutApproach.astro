---
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Competencias complementarias',
    intro:
      'Trabajo con metodologías de diseño centrado en las personas (UCD) y el modelo AIDAR: investigo, analizo, pruebo y optimizo experiencias digitales para responder a objetivos reales.',
    method:
      'La experiencia en diseño gráfico, contenido para redes sociales, landing pages, email marketing, retoque de imágenes y edición de vídeo fortalece la comunicación visual. Estas competencias apoyan la presentación de información, pero no sustituyen los métodos técnicos de análisis forense.',
    skills: [
      'Diseño centrado en las personas (UCD)',
      'Modelo AIDAR',
      'Diseño y prototipado en Figma',
      'Email marketing y Klaviyo',
      'Retoque de imágenes',
      'Edición de vídeo',
    ],
  },
  en: {
    title: 'Complementary skills',
    intro:
      'I work with User-Centered Design (UCD) methodologies and the AIDAR model: researching, analyzing, testing, and optimizing digital experiences to meet real goals.',
    method:
      'Experience in graphic design, social content, landing pages, email marketing, image retouching, and video editing strengthens visual communication. These skills support how information is presented but do not replace technical forensic methods.',
    skills: [
      'User-Centered Design (UCD)',
      'AIDAR model',
      'Figma design and prototyping',
      'Email marketing and Klaviyo',
      'Image retouching',
      'Video editing',
    ],
  },
}[locale];
---

<section class="section" aria-labelledby="about-approach-title">
  <div class="grid gap-6 md:grid-cols-[minmax(0,1.3fr)_minmax(16rem,0.7fr)]">
    <article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
      <h2
        id="about-approach-title"
        class="mb-3 text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.1] font-bold tracking-[-0.03em]"
      >
        {text.title}
      </h2>
      <p class="leading-[1.6] text-ink-soft">{text.intro}</p>
      <p class="mb-0 leading-[1.6] text-ink-soft">{text.method}</p>
    </article>
    <aside class="flex flex-col justify-center border-2 border-dashed border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {text.skills.map((skill) => (
          <li class="border-2 border-ink bg-bg px-2 py-1 font-mono text-xs font-bold text-ink">{skill}</li>
        ))}
      </ul>
    </aside>
  </div>
</section>
