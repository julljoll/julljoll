---
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Gobernanza de IA, procesos y competencias complementarias',
    intro:
      'Integro procesos de gobernanza de IA por diseño (IA explicable, recuperación y generación aumentada en entorno local, inteligencia documental y validación de seguridad y fiabilidad sobre ecosistemas de IBM y Oracle) con metodologías de diseño centrado en las personas (UCD) y el modelo AIDAR: investigo, analizo, pruebo y optimizo flujos e informes técnicos para que cada hallazgo muestre su fuente, nivel de confianza y trazabilidad.',
    method:
      'Alineo el proceso técnico con estándares como NIST AI RMF, ISO/IEC 27001, ISO/IEC 42001 (gestión de IA) e ISO/IEC 27037 (evidencia digital). La experiencia en diseño de experiencia de usuario, comunicación visual, estructuración de contenidos, retoque de imágenes y edición de vídeo fortalece la claridad de las interfaces explicables y los dictámenes, sin sustituir los métodos técnicos de adquisición, preservación ni análisis forense.',
    mappingTitle: 'Procesos de arquitectura y evidencia técnica',
    mapping: [
      {
        area: 'AI-First UX/UI (Explainable AI)',
        evidence:
          'Procesos de visualización e interfaces que muestran fuente, nivel de confianza y trazabilidad de cada afirmación (“afirmación → fragmento exacto del documento”).',
      },
      {
        area: 'Ingesta y estructuración documental',
        evidence:
          'Flujos de transformación de expedientes escaneados o no estructurados en datos organizados por fragmentos con metadatos de página y hash SHA-256 para indexación RAG.',
      },
      {
        area: 'Trust & Safety en entorno local',
        evidence:
          'Procesos de validación anti-alucinación, control de fiabilidad y mitigación de sesgo ejecutados en entornos locales auditables con tecnología de IBM y Oracle.',
      },
      {
        area: 'Reporte forense y compliance',
        evidence:
          'Cadena de custodia documentada, registro de auditoría inmutable con marcas de tiempo (timestamps), hashes SHA-256 y dictamen técnico exportable.',
      },
    ],
    skills: [
      'IBM',
      'Oracle',
      'Explainable AI (XAI)',
      'RAG',
      'Document Intelligence',
      'AI Governance',
      'Responsible AI',
      'Data Privacy',
      'Chain of Custody',
      'Digital Forensics',
      'On-premise AI',
      'NIST AI RMF',
      'ISO/IEC 27001 · 42001 · 27037',
      'Diseño centrado en las personas (UCD)',
      'Modelo AIDAR',
    ],
  },
  en: {
    title: 'AI governance, processes, and complementary skills',
    intro:
      'I combine governance-by-design AI workflows (Explainable AI, on-premise retrieval-augmented generation, Document Intelligence, and trust & safety validation across IBM and Oracle ecosystems) with User-Centered Design (UCD) methodologies and the AIDAR model: researching, analyzing, testing, and optimizing interfaces and technical reports so every claim displays its source, confidence, and traceability.',
    method:
      'I align technical workflows with frameworks such as NIST AI RMF, ISO/IEC 27001, ISO/IEC 42001 (AI management), and ISO/IEC 27037 (digital evidence). Experience in user experience design, visual communication, content structuring, image retouching, and video editing strengthens XAI interfaces and report presentation without replacing technical forensic acquisition, preservation, or analysis methods.',
    mappingTitle: 'Architecture processes and technical evidence',
    mapping: [
      {
        area: 'AI-First UX/UI (Explainable AI)',
        evidence:
          'Visualization workflows and interfaces showing source, confidence score, and traceability for every claim (“claim → exact document passage”).',
      },
      {
        area: 'Document Ingestion & Structuring',
        evidence:
          'Ingestion workflows converting scanned or unstructured case files into structured data chunks with page metadata and SHA-256 hashes indexed for RAG.',
      },
      {
        area: 'On-Premise Trust & Safety',
        evidence:
          'Anti-hallucination validation, reliability verification, and bias mitigation processes running in local, auditable IBM and Oracle environments.',
      },
      {
        area: 'Forensic Reporting & Compliance',
        evidence:
          'Documented chain of custody, immutable audit logs with timestamps, SHA-256 hashes, and exportable forensic reports.',
      },
    ],
    skills: [
      'IBM',
      'Oracle',
      'Explainable AI (XAI)',
      'RAG',
      'Document Intelligence',
      'AI Governance',
      'Responsible AI',
      'Data Privacy',
      'Chain of Custody',
      'Digital Forensics',
      'On-premise AI',
      'NIST AI RMF',
      'ISO/IEC 27001 · 42001 · 27037',
      'User-Centered Design (UCD)',
      'AIDAR model',
    ],
  },
}[locale];
---

<section class="section" aria-labelledby="about-approach-title">
  <div class="grid gap-6 md:grid-cols-[minmax(0,1.3fr)_minmax(16rem,0.7fr)]">
    <article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
      <h2
        id="about-approach-title"
        class="mb-3 text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.1] font-bold tracking-[-0.03em]"
      >
        {text.title}
      </h2>
      <p class="leading-[1.6] text-ink-soft">{text.intro}</p>
      <p class="mb-0 leading-[1.6] text-ink-soft">{text.method}</p>
    </article>
    <aside class="flex flex-col justify-center border-2 border-dashed border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {text.skills.map((skill) => (
          <li class="border-2 border-ink bg-bg px-2 py-1 font-mono text-xs font-bold text-ink">{skill}</li>
        ))}
      </ul>
    </aside>
  </div>

  <div class="mt-6 border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
    <h3 class="m-0 mb-4 text-xl font-bold">{text.mappingTitle}</h3>
    <div class="grid gap-4 md:grid-cols-2">
      {text.mapping.map((item) => (
        <div class="border-2 border-ink bg-bg p-4">
          <p class="m-0 font-mono text-xs font-bold tracking-[0.08em] text-accent uppercase">{item.area}</p>
          <p class="mt-2 mb-0 text-sm leading-[1.55] text-ink-soft">{item.evidence}</p>
        </div>
      ))}
    </div>
  </div>
</section>
