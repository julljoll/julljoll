---
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = {
  es: {
    title: 'Gobernanza de IA, arquitectura y competencias complementarias',
    intro:
      'Integro gobernanza de IA por diseño (Explainable AI, RAG on-premise, Document Intelligence con Docling y filtros Trust & Safety con IBM Granite Guardian) con metodologías de diseño centrado en las personas (UCD) y el modelo AIDAR: investigo, analizo, pruebo y optimizo interfaces e informes técnicos para que cada hallazgo muestre su fuente, nivel de confianza y trazabilidad.',
    method:
      'Alineo la arquitectura técnica con referencias como NIST AI RMF, ISO/IEC 27001, ISO/IEC 42001 (gestión de IA) e ISO/IEC 27037 (evidencia digital). La experiencia en diseño UX/UI en Figma, comunicación visual, landing pages, email marketing, retoque de imágenes y edición de vídeo fortalece la presentación de interfaces XAI y dictámenes, pero no sustituye los métodos técnicos de adquisición, preservación ni análisis forense.',
    mappingTitle: 'Arquitectura y evidencia técnica',
    mapping: [
      {
        area: 'AI-First UX/UI (XAI)',
        evidence:
          'Interfaces que muestran fuente, confianza y trazabilidad de cada afirmación (“afirmación → fragmento exacto del documento”).',
      },
      {
        area: 'Ingesta de documentos',
        evidence:
          'Pipelines con Docling para convertir expedientes en datos estructurados: chunks con metadatos de página y hash SHA-256 hacia índice RAG.',
      },
      {
        area: 'Trust & Safety On-Premise',
        evidence:
          'Controles anti-alucinación y mitigación de sesgo con IBM Granite Guardian ejecutados en entorno local auditable.',
      },
      {
        area: 'Reporte forense y compliance',
        evidence:
          'Cadena de custodia documentada, registro de auditoría inmutable con timestamps, hashes SHA-256 y dictamen exportable.',
      },
    ],
    skills: [
      'Explainable AI (XAI)',
      'RAG',
      'Document Intelligence',
      'Docling',
      'IBM Granite',
      'Granite Guardian',
      'AI Governance',
      'Responsible AI',
      'Data Privacy',
      'Chain of Custody',
      'Digital Forensics',
      'On-premise AI',
      'NIST AI RMF',
      'ISO/IEC 27001 · 42001 · 27037',
      'Python · Podman · OCI',
      'Diseño centrado en las personas (UCD)',
      'Modelo AIDAR',
      'Diseño y prototipado en Figma',
    ],
  },
  en: {
    title: 'AI governance, architecture, and complementary skills',
    intro:
      'I combine governance-by-design AI (Explainable AI, on-premise RAG, Document Intelligence with Docling, and Trust & Safety guardrails with IBM Granite Guardian) with User-Centered Design (UCD) methodologies and the AIDAR model: researching, analyzing, testing, and optimizing interfaces and technical reports so every claim displays its source, confidence, and traceability.',
    method:
      'I align technical architecture with frameworks such as NIST AI RMF, ISO/IEC 27001, ISO/IEC 42001 (AI management), and ISO/IEC 27037 (digital evidence). Experience in Figma UX/UI prototyping, visual communication, landing pages, email marketing, image retouching, and video editing strengthens XAI interfaces and report presentation, but does not replace technical forensic acquisition, preservation, or analysis methods.',
    mappingTitle: 'Architecture and technical evidence',
    mapping: [
      {
        area: 'AI-First UX/UI (XAI)',
        evidence:
          'Interfaces showing source, confidence score, and traceability for every claim (“claim → exact document passage”).',
      },
      {
        area: 'Document Ingestion',
        evidence:
          'Docling pipelines converting scanned case files into structured data: chunks with page metadata and SHA-256 hashes indexed for RAG.',
      },
      {
        area: 'On-Premise Trust & Safety',
        evidence:
          'Anti-hallucination and bias mitigation filters using IBM Granite Guardian in local, auditable environments.',
      },
      {
        area: 'Forensic Reporting & Compliance',
        evidence:
          'Documented chain of custody, immutable audit logs with timestamps, SHA-256 hashes, and exportable forensic reports.',
      },
    ],
    skills: [
      'Explainable AI (XAI)',
      'RAG',
      'Document Intelligence',
      'Docling',
      'IBM Granite',
      'Granite Guardian',
      'AI Governance',
      'Responsible AI',
      'Data Privacy',
      'Chain of Custody',
      'Digital Forensics',
      'On-premise AI',
      'NIST AI RMF',
      'ISO/IEC 27001 · 42001 · 27037',
      'Python · Podman · OCI',
      'User-Centered Design (UCD)',
      'AIDAR model',
      'Figma design and prototyping',
    ],
  },
}[locale];
---

<section class="section" aria-labelledby="about-approach-title">
  <div class="grid gap-6 md:grid-cols-[minmax(0,1.3fr)_minmax(16rem,0.7fr)]">
    <article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
      <h2
        id="about-approach-title"
        class="mb-3 text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.1] font-bold tracking-[-0.03em]"
      >
        {text.title}
      </h2>
      <p class="leading-[1.6] text-ink-soft">{text.intro}</p>
      <p class="mb-0 leading-[1.6] text-ink-soft">{text.method}</p>
    </article>
    <aside class="flex flex-col justify-center border-2 border-dashed border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {text.skills.map((skill) => (
          <li class="border-2 border-ink bg-bg px-2 py-1 font-mono text-xs font-bold text-ink">{skill}</li>
        ))}
      </ul>
    </aside>
  </div>

  <div class="mt-6 border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
    <h3 class="m-0 mb-4 text-xl font-bold">{text.mappingTitle}</h3>
    <div class="grid gap-4 md:grid-cols-2">
      {text.mapping.map((item) => (
        <div class="border-2 border-ink bg-bg p-4">
          <p class="m-0 font-mono text-xs font-bold tracking-[0.08em] text-accent uppercase">{item.area}</p>
          <p class="mt-2 mb-0 text-sm leading-[1.55] text-ink-soft">{item.evidence}</p>
        </div>
      ))}
    </div>
  </div>
</section>
