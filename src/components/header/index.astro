---
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';
import { faMagnifyingGlass, faRss } from '@fortawesome/free-solid-svg-icons';
import Icon from '@/components/Icon.astro';
import ContactLinks from '@/components/header/ContactLinks.astro';
import { ANIMATED_UNDERLINE_CLASSES } from '@/lib/animatedUnderline';
import { withBase, withoutBase } from '@/lib/paths';
import { GITHUB_URL, LINKEDIN_URL, SITE_NAME } from '@/lib/site';
import { getMessages, localizedPath, type Locale } from '@/lib/i18n';
import BrandLogo from './BrandLogo.astro';
import ThemePicker from './ThemePicker.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const message = getMessages(locale);
const currentPath = withoutBase(Astro.url.pathname);
const navMenuItems = [
  {
    href: withBase(localizedPath('/', locale)),
    title: message.home,
    current: currentPath === '/' || currentPath === '/en/',
  },
  {
    href: withBase(localizedPath('/experience/', locale)),
    title: message.about,
    current: currentPath === '/experience/' || currentPath === '/en/experience/',
  },
  {
    href: withBase(localizedPath('/projects/', locale)),
    title: message.projects,
    current: currentPath === '/projects/' || currentPath === '/en/projects/',
  },
  {
    href: withBase(localizedPath('/blog/', locale)),
    title: message.blog,
    current: currentPath.startsWith('/blog') || currentPath.startsWith('/tags'),
  },
];
---

<header class="sticky top-0 z-20 border-b-5 border-ink bg-bg">
  <nav class="nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Primary navigation'}>
    <a class="brand" href={withBase(localizedPath('/', locale))} aria-label={SITE_NAME}>
      <BrandLogo />
      <span>{SITE_NAME}</span>
    </a>

    <div class:list={['nav-links', ...ANIMATED_UNDERLINE_CLASSES]}>
      {navMenuItems.map((item) => {
        return (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            {item.title}
          </a>
        );
      })}
    </div>

    <div class="flex items-center gap-[0.45rem] max-[860px]:ml-auto">
      <div class="flex items-center gap-[0.45rem] max-sm:hidden">
        <button class="nav-icon-link" type="button" id="search-open" aria-label={message.searchLabel}>
          <Icon icon={faMagnifyingGlass} />
        </button>
        <a class="nav-icon-link" href={GITHUB_URL} aria-label={message.github} target="_blank" rel="noopener">
          <Icon icon={faGithub} />
        </a>
        {LINKEDIN_URL && (
          <a class="nav-icon-link" href={LINKEDIN_URL} aria-label={message.linkedin} target="_blank" rel="noopener">
            <Icon icon={faLinkedin} />
          </a>
        )}
        <div class="contact-links-desktop">
          <ContactLinks locale={locale} />
        </div>
        <a class="nav-icon-link" href={withBase('/rss.xml')} aria-label={message.rss}>
          <Icon icon={faRss} />
        </a>
      </div>
      <a
        class="language-link"
        href={withBase(localizedPath(Astro.url.pathname, locale === 'es' ? 'en' : 'es'))}
        aria-label={`${message.language}: ${message.switchLanguage}`}
        lang={locale === 'es' ? 'en' : 'es'}
      >
        {message.switchLanguage}
      </a>
      <ThemePicker locale={locale} />
      <ThemeToggle locale={locale} />
    </div>

    <details class="hidden max-[860px]:flex">
      <summary class="nav-menu-button" aria-label={locale === 'es' ? 'Abrir navegación' : 'Open navigation'}>
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <div class="nav-menu-panel">
        {navMenuItems.map((item) => {
          return (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.title}
            </a>
          );
        })}
        <ContactLinks locale={locale} />
      </div>
    </details>
  </nav>
</header>

<style>
  @reference "@/styles/global.css";

  .nav {
    @apply relative mx-auto flex max-w-(--max) items-center justify-between gap-4 px-5 py-[0.85rem];
    @apply max-sm:gap-2 max-sm:px-4;
  }

  .brand {
    @apply inline-flex items-center gap-[0.95rem] font-heading text-[1.3rem] font-bold tracking-[-0.02em] text-ink;
    @apply max-sm:gap-[0.6rem] max-sm:text-[1.1rem];
  }

  .nav-links {
    @apply flex items-center gap-5 font-heading font-semibold text-[1rem] text-ink max-[860px]:hidden;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    @apply text-accent;
  }

  .nav-menu-button {
    @apply inline-flex size-[2.1rem] list-none flex-col items-center justify-center gap-[0.22rem];
    @apply rounded-none border-2 border-ink bg-bg-elevated text-ink shadow-[3px_3px_0_0_var(--ink)];
    @apply transition-[translate,box-shadow,background-color,color] duration-120 ease-[ease];
  }

  .nav-menu-button::-webkit-details-marker {
    display: none;
  }
  .nav-menu-button::marker {
    content: '';
  }

  .nav-menu-button span {
    @apply block h-0.5 w-[0.92rem] bg-current;
  }

  .nav-menu-panel {
    @apply absolute top-[calc(100%_+_0.5rem)] right-5 z-30 grid min-w-[min(18rem,calc(100vw-2rem))] p-[0.35rem];
    @apply rounded-none border-2 border-ink bg-bg-elevated shadow-[4px_4px_0_0_var(--ink)];
  }

  .nav-menu-panel a {
    @apply rounded-none px-[0.7rem] py-[0.62rem] font-heading text-[0.9rem] font-semibold text-ink;
  }

  .nav-menu-panel > :global(.contact-links) {
    @apply flex-wrap border-t-2 border-ink p-[0.55rem];
  }

  .contact-links-desktop {
    @apply max-[860px]:hidden;
  }

  .nav-menu-panel a:hover,
  .nav-menu-panel a[aria-current='page'] {
    @apply bg-accent text-bg;
  }

  .nav-icon-link {
    @apply inline-flex size-[2.1rem] items-center justify-center rounded-none border-2 border-ink bg-bg-elevated text-ink;
    @apply shadow-[3px_3px_0_0_var(--ink)] transition-[translate,box-shadow,background-color,color] duration-120 ease-[ease];
  }

  .language-link {
    @apply rounded-none border-2 border-ink bg-bg-elevated px-2 py-1 font-heading text-[0.78rem] font-bold text-ink shadow-[3px_3px_0_0_var(--ink)];
  }

  .nav-menu-button:hover,
  [open] > .nav-menu-button,
  .nav-icon-link:hover {
    @apply translate-x-[1px] translate-y-[1px] shadow-[2px_2px_0_0_var(--ink)];
  }
</style>
