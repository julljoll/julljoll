---
import type { Locale } from '@/lib/i18n';
import { FEATURED_PROJECTS } from '@/lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = {
  es: {
    section: 'Proyectos seleccionados',
    primaryBadge: 'PROYECTO PRINCIPAL · SHA256.US',
    repoLabel: 'Repositorio:',
    open: 'Ver repositorio en GitHub',
  },
  en: {
    section: 'Selected projects',
    primaryBadge: 'PRIMARY PROJECT · SHA256.US',
    repoLabel: 'Repository:',
    open: 'View repository on GitHub',
  },
}[locale];
---

<section class="section" aria-label={labels.section}>
  <h2 class="sr-only">{labels.section}</h2>
  <div class="grid gap-5 md:grid-cols-2">
    {FEATURED_PROJECTS.map((project) => (
      <article class:list={['project-card', project.primary && 'project-card-primary']}>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono text-xs font-bold tracking-[0.06em] text-accent uppercase">
            {project.role[locale]}
          </span>
          {project.primary && (
            <span class="border-2 border-ink bg-accent px-2.5 py-0.5 font-mono text-xs font-bold tracking-[0.06em] text-bg uppercase shadow-[2px_2px_0_0_var(--ink)]">
              {labels.primaryBadge}
            </span>
          )}
        </div>
        <h2>{project.name}</h2>
        <p class="mt-1 mb-0 font-mono text-xs text-ink-soft">
          {labels.repoLabel} <strong class="text-ink">{project.repoSlug}</strong>
        </p>
        <p>{project.description[locale]}</p>
        <ul aria-label={locale === 'es' ? 'Áreas del proyecto' : 'Project focus'}>
          {project.focus[locale].map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
          <a href={project.url} target="_blank" rel="noopener noreferrer">
            {labels.open} <span aria-hidden="true">↗</span>
          </a>
          {project.primary && (
            <span class="font-mono text-xs font-bold text-ink-soft">SHA256.US · Digital Forensics</span>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .project-card {
    @apply flex flex-col border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)];
  }

  .project-card-primary {
    @apply md:col-span-2 border-3 bg-bg-elevated p-7 shadow-[8px_8px_0_0_var(--ink)];
  }

  .project-card h2 {
    @apply m-0 text-[1.4rem] leading-[1.2] font-bold tracking-[-0.02em] text-ink;
  }

  .project-card-primary h2 {
    @apply text-[clamp(1.6rem,3vw,2.1rem)];
  }

  .project-card p {
    @apply mt-3 mb-0 leading-[1.6] text-ink-soft;
  }

  .project-card ul {
    @apply mt-4 mb-5 flex list-none flex-wrap gap-2 p-0;
  }

  .project-card li {
    @apply border-2 border-ink bg-bg px-2 py-1 font-mono text-xs font-bold text-ink;
  }

  .project-card a {
    @apply mt-auto w-fit font-heading font-bold text-accent underline decoration-2 underline-offset-4;
  }
</style>
