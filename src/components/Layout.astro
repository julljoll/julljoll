---
import { ClientRouter } from 'astro:transitions';
import SearchOverlay from '@/components/search/SearchOverlay.astro';
import SmartCursor from '@/components/SmartCursor.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/header/index.astro';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, SITE_NAME } from '@/lib/site';
import { getLocale, localizedPath } from '@/lib/i18n';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const { title, description, canonicalPath = '/', ogType = 'website' } = Astro.props;
const locale = getLocale(Astro.url.pathname);

const canonicalUrl = new URL(withBase(localizedPath(canonicalPath, locale)), Astro.site).toString();
const esUrl = new URL(withBase(localizedPath(canonicalPath, 'es')), Astro.site).toString();
const enUrl = new URL(withBase(localizedPath(canonicalPath, 'en')), Astro.site).toString();
const ogImageUrl = new URL(withBase('/assets/og.png'), Astro.site).toString();
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlternate = locale === 'es' ? 'en_US' : 'es_ES';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f0eee9" />
    <link rel="preload" href={withBase('/assets/inter.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/assets/space-grotesk.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/assets/jetbrains-mono.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${description}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${SITE_NAME} — ${description}`} />

    <script>
      import { initializePalette } from '@/lib/palette';

      initializePalette();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header locale={locale} />

    <slot />

    <Footer locale={locale} />

    <SearchOverlay locale={locale} />

    <SmartCursor />
  </body>
</html>
