---
import { SITE_NAME, SOURCE_URL } from '@/lib/site';
import { getMessages, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const message = getMessages(locale);
const fullYear = new Date().getFullYear();
---

<footer class="flex items-center justify-center gap-4 border-t-4 border-ink px-5 py-7 font-heading text-[0.95rem] font-semibold text-ink">
  <span>
    &copy; {fullYear}
    <a href={SOURCE_URL} target="_blank" rel="noopener" class="underline underline-offset-4">
      {SITE_NAME} · {message.footerSource}
    </a>
  </span>
</footer>
