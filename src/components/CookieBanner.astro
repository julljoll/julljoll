---
import { getMessages, localizedPath, type Locale } from '@/lib/i18n';
import { withBase } from '@/lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const message = getMessages(locale);
const cookiesPath = withBase(localizedPath('/cookies/', locale));
---

<aside
  id="cookie-banner"
  class="fixed right-4 bottom-4 left-4 z-50 mx-auto hidden max-w-xl border-2 border-ink bg-bg-elevated p-5 text-ink shadow-[6px_6px_0_0_var(--ink)] md:left-auto md:right-6 md:bottom-6"
  role="region"
  aria-label={message.cookies}
>
  <div class="flex flex-col gap-4">
    <div class="flex items-start gap-3">
      <span class="text-2xl" aria-hidden="true">🍪</span>
      <p class="m-0 text-sm leading-[1.55] text-ink-soft">
        {message.cookiesBannerText}
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-3 font-heading text-sm font-bold">
      <a
        href={cookiesPath}
        class="text-ink underline decoration-2 underline-offset-4 hover:text-accent"
      >
        {message.cookiesBannerMore}
      </a>
      <button
        type="button"
        id="cookie-banner-accept"
        class="cursor-pointer border-2 border-ink bg-accent px-4 py-1.5 font-bold text-ink shadow-[2px_2px_0_0_var(--ink)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0"
      >
        {message.cookiesBannerAccept}
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  function setupCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-banner-accept');
    if (!banner || !acceptBtn) return;

    try {
      if (localStorage.getItem('cookie-consent') === 'accepted') {
        banner.classList.add('hidden');
      } else {
        banner.classList.remove('hidden');
      }
    } catch {
      banner.classList.remove('hidden');
    }

    acceptBtn.onclick = function () {
      try {
        localStorage.setItem('cookie-consent', 'accepted');
      } catch {
        // no-op
      }
      banner.classList.add('hidden');
    };
  }

  setupCookieBanner();
  document.addEventListener('astro:page-load', setupCookieBanner);
</script>

