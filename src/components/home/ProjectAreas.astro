---
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = {
  es: {
    label: 'SHA256.US · Governed AI & Digital Forensics',
    title: 'Áreas del proyecto',
    intro:
      'Arquitecturas de IA gobernada, ingesta documental estructurada y procesos para la preservación, cadena de custodia y análisis técnico de evidencia digital.',
    areas: [
      {
        title: 'Dispositivos móviles',
        description:
          'Reparación, extracción de información y revisión de audios, imágenes, mensajes y contenido de aplicaciones de mensajería bajo trazabilidad forense.',
      },
      {
        title: 'Evidencia y documentos digitales',
        description:
          'Ingesta y estructuración de expedientes complejos (fragmentación con metadatos de página y verificación criptográfica SHA-256), contratos electrónicos, firmas y análisis de posibles alteraciones.',
      },
      {
        title: 'Análisis técnico-jurídico',
        description:
          'Procesos de consulta jurídica asistida en entorno local (On-Premise), IA explicable (XAI) con trazabilidad exacta a la fuente, controles de validación contra alucinaciones y sesgos sobre arquitecturas de IBM y Oracle, y dictámenes exportables con cadena de custodia.',
      },
    ],
  },
  en: {
    label: 'SHA256.US · Governed AI & Digital Forensics',
    title: 'Project focus areas',
    intro:
      'Governed AI architectures, structured document ingestion, and workflows for the preservation, chain of custody, and technical analysis of digital evidence.',
    areas: [
      {
        title: 'Mobile devices',
        description:
          'Repair, data extraction, and review of audio, images, messages, and messaging app content with forensic traceability.',
      },
      {
        title: 'Digital evidence and documents',
        description:
          'Structured ingestion of complex case files (chunking with page metadata and SHA-256 cryptographic verification), electronic contracts, signatures, and analysis of potential alterations.',
      },
      {
        title: 'Technical and legal analysis',
        description:
          'On-premise legal retrieval workflows, Explainable AI (XAI) tracing every claim to its exact source, anti-hallucination and bias validation controls across IBM and Oracle environments, and exportable chain-of-custody reports.',
      },
    ],
  },
}[locale];
---

<section class="section" aria-labelledby="project-areas-title">
  <div class="mb-6 max-w-[44rem]">
    <p class="font-mono text-sm font-bold tracking-[0.12em] text-accent uppercase">{content.label}</p>
    <h1 id="project-areas-title" class="mt-2 text-[clamp(1.8rem,4vw,2.7rem)] leading-tight tracking-[-0.03em]">
      {content.title}
    </h1>
    <p class="mt-3 max-w-[40rem] leading-[1.6] text-ink-soft">{content.intro}</p>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    {content.areas.map((area) => (
      <article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
        <h2 class="m-0 text-[1.4rem] leading-[1.2] font-bold tracking-[-0.02em] text-ink">{area.title}</h2>
        <p class="mt-3 mb-0 leading-[1.6] text-ink-soft">{area.description}</p>
      </article>
    ))}
  </div>
</section>
